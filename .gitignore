# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets: the Gemini API key lives here
.env

# Raw downloads: not in git. scripts/00_get_data.py fetches the exact snapshot from the
# GitHub release; MANIFEST.json (provenance) and SHA256SUMS (checksums) stay tracked.
data/raw/*
!data/raw/MANIFEST.json
!data/raw/SHA256SUMS
data/processed/*.jpg
data/processed/*.png

# Generated images
output/

.DS_Store
data/processed/*/tiles/
data/raw/lidar/
data/processed/*.npz

# Landmark reference photos (Track 3): downloaded by scripts/19_landmark_refs.py; licenses in data/landmarks/manifest.json
data/landmarks/refs/

# Promo videos' camera paths: local only (the videos themselves are in output/flyover/, ignored above)
config/flyover/promo*.json
